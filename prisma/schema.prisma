generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lead {
  id          String     @id @default(cuid())
  name        String
  instagram   String?
  telegram    String?
  phone       String?
  email       String?
  comment     String?
  source      String?
  geo         String?
  niche       String?
  amount      Float?
  tags        String[]
  status      LeadStatus @default(NEW)
  lastContact DateTime?
  remindAt    DateTime?
  remindSent  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tasks      Task[]
  activities Activity[]
  deals      Deal[]
}

enum LeadStatus {
  NEW
  CONTACTED
  NEGOTIATION
  WON
  LOST
}

model Deal {
  id          String     @id @default(cuid())
  leadId      String
  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company     String?
  description String?
  budget      Float?
  deadline    DateTime?
  status      DealStatus @default(PLANNING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tasks      Task[]
  activities Activity[]
}

enum DealStatus {
  PLANNING
  DESIGN
  DEVELOPMENT
  TESTING
  COMPLETED
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  deadline    DateTime?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  assignee    String?
  remindAt    DateTime?
  remindSent  Boolean    @default(false)
  leadId      String?
  lead        Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  content   String
  leadId    String?
  lead      Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  dealId    String?
  deal      Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
}

enum ActivityType {
  NOTE
  STATUS_CHANGE
  MESSAGE
  CALL
  TASK_CREATED
  TASK_DONE
  DEAL_CREATED
}

model Campaign {
  id         String              @id @default(cuid())
  name       String
  status     CampaignStatus      @default(DRAFT)
  /// Ніша за замовчуванням — успадковується отримувачами, якщо в них своя не задана.
  niche      String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  recipients CampaignRecipient[]
}

enum CampaignStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
}

model CampaignRecipient {
  id                String          @id @default(cuid())
  campaignId        String
  campaign          Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  instagramUsername String
  messageText       String
  /// Ніша конкретного отримувача — перекриває нішу кампанії.
  niche             String?
  status            RecipientStatus @default(PENDING)
  sentAt            DateTime?
  errorMessage      String?
  createdAt         DateTime        @default(now())

  @@index([campaignId])
  @@index([campaignId, status])
}

enum RecipientStatus {
  PENDING
  SENDING
  SENT
  ERROR
  NOT_FOUND
  SKIPPED
}

/// Кандидат, знайдений розвідкою в Instagram. Нікнейм — унікальний ключ,
/// той самий, що і в базі розсилок, тому дублі відсікаються звіркою по ньому.
model Prospect {
  id        String         @id @default(cuid())
  instagram String         @unique
  status    ProspectStatus @default(NEW)

  // — Сигнали, зібрані з профілю. Зберігаємо все, навіть те, що не фільтрує,
  //   щоб у таблиці було видно підставу для рішення.
  fullName   String?
  bio        String?
  category   String?
  followers  Int?
  postsCount Int?
  isPrivate  Boolean @default(false)

  // — Головний критерій: чи є згадка про сайт.
  externalUrl  String?
  hasWebsite   Boolean @default(false)
  /// Що саме визнано сайтом або посиланням: домен, linktr.ee, taplink.
  siteEvidence String?

  /// Звідки прийшов: "similar:username", "hashtag:тег", "geo:місто".
  source String?
  score  Int    @default(0)

  /// Чернетка кампанії, у яку кандидата вже додано.
  campaignId String?
  notes      String?

  checkedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([status, score])
}

enum ProspectStatus {
  /// Знайдено, чекає на перегляд.
  NEW
  /// Схвалено вручну, готовий до кампанії.
  APPROVED
  /// Відхилено — більше ніколи не пропонувати.
  REJECTED
  /// Уже доданий у чернетку кампанії.
  QUEUED
}

/// Замовлення на розвідку. CRM живе на Vercel і не може достукатись до бота
/// на домашньому компʼютері, тому кнопка лишає запис тут, а бот його забирає.
model ScoutRun {
  id     String         @id @default(cuid())
  status ScoutRunStatus @default(REQUESTED)
  limit  Int?

  visited    Int     @default(0)
  added      Int     @default(0)
  duplicates Int     @default(0)
  withSite   Int     @default(0)
  lastSeed   String?
  error      String?

  requestedAt DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  /// Оновлюється на кожен звіт бота — за ним видно, що розвідка ще жива.
  updatedAt   DateTime  @updatedAt

  @@index([status, requestedAt])
}

enum ScoutRunStatus {
  /// Кнопку натиснуто, бот ще не забрав.
  REQUESTED
  RUNNING
  DONE
  FAILED
}

/// Точки входу для розвідки: від кого відштовхуватись у пошуку.
model ProspectSeed {
  id       String   @id @default(cuid())
  type     SeedType
  value    String
  priority Int      @default(0)

  lastRunAt DateTime?
  runCount  Int       @default(0)
  /// Скільки нових кандидатів дало це насіння — щоб бачити, що працює.
  foundCount Int      @default(0)
  /// Вичерпане насіння більше не обходимо.
  exhausted Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, value])
  @@index([exhausted, priority])
}

enum SeedType {
  /// Схожі акаунти до вказаного профілю.
  SIMILAR
  HASHTAG
  GEO
}

/// База розсилок — одна картка на Instagram-акаунт, незалежно від кількості кампаній.
model BroadcastLead {
  id          String          @id @default(cuid())
  /// Основний унікальний ідентифікатор ліда.
  instagram   String          @unique
  niche       String?
  /// Кількість УСПІШНИХ відправок — джерело для колонки «кількість попередніх розсилок».
  sendCount   Int             @default(0)
  firstSentAt DateTime?
  lastSentAt  DateTime?
  lastStatus  RecipientStatus @default(SENT)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  sends BroadcastSend[]

  @@index([niche])
  @@index([lastSentAt])
}

/// Історія кожної окремої відправки в межах картки ліда.
model BroadcastSend {
  id           String          @id @default(cuid())
  leadId       String
  lead         BroadcastLead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// Кампанію могли видалити — тому звʼязок мʼякий, а назву зберігаємо копією.
  campaignId   String?
  campaignName String
  messageText  String
  niche        String?
  status       RecipientStatus
  sentAt       DateTime
  createdAt    DateTime        @default(now())

  @@index([leadId])
  @@index([sentAt])
}
